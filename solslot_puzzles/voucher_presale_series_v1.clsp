(mod
  (
    SELF_MOD_HASH
    SINGLETON_STRUCT
    PRESALE_TERMS_HASH
    INVENTORY_CAP
    SOLD_COUNT
    REDEEMED_COUNT
    REFUNDED_COUNT
    PHASE
    my_id
    my_inner_puzzle_hash
    my_amount
    transition_tag
    transition_payload
  )
  (include condition_codes.clib)
  (include utils.clib)
  (include utility_macros.clib)
  (defconstant PHASE_PRESALE 1)
  (defconstant PHASE_LIVE 2)
  (defconstant PHASE_CANCELED 3)
  (defconstant TRANSITION_SALE 1)
  (defconstant TRANSITION_LAUNCH 2)
  (defconstant TRANSITION_CANCEL 3)
  (defconstant TRANSITION_REFUND 4)
  (defconstant TRANSITION_REDEEM 5)
  (defun-inline next-inner-hash (sold redeemed refunded phase)
    (curry_hashes
      SELF_MOD_HASH
      (sha256 1 SELF_MOD_HASH)
      (sha256 1 SINGLETON_STRUCT)
      (sha256 1 PRESALE_TERMS_HASH)
      (sha256 1 INVENTORY_CAP)
      (sha256 1 sold)
      (sha256 1 redeemed)
      (sha256 1 refunded)
      (sha256 1 phase)))
  (defun-inline next-state (sold redeemed refunded phase)
    (list CREATE_COIN
      (next-inner-hash sold redeemed refunded phase)
      my_amount))
  (defun-inline presale-transition ()
    (if (= transition_tag TRANSITION_SALE)
      (assert
        (= PHASE PHASE_PRESALE)
        (< SOLD_COUNT INVENTORY_CAP)
        (next-state (+ SOLD_COUNT 1) REDEEMED_COUNT REFUNDED_COUNT PHASE_PRESALE))
      (if (= transition_tag TRANSITION_REFUND)
        (assert
          (= PHASE PHASE_PRESALE)
          (< REFUNDED_COUNT SOLD_COUNT)
          (next-state SOLD_COUNT REDEEMED_COUNT (+ REFUNDED_COUNT 1) PHASE_PRESALE))
        (if (= transition_tag TRANSITION_LAUNCH)
          (assert
            (= PHASE PHASE_PRESALE)
            (next-state SOLD_COUNT REDEEMED_COUNT REFUNDED_COUNT PHASE_LIVE))
          (if (= transition_tag TRANSITION_CANCEL)
            (assert
              (= PHASE PHASE_PRESALE)
              (next-state SOLD_COUNT REDEEMED_COUNT REFUNDED_COUNT PHASE_CANCELED))
            (assert
              (= transition_tag TRANSITION_REDEEM)
              (= PHASE PHASE_LIVE)
              (< REDEEMED_COUNT SOLD_COUNT)
              (next-state SOLD_COUNT (+ REDEEMED_COUNT 1) REFUNDED_COUNT PHASE_LIVE)))))))
  (assert
    (is-size-b32 SELF_MOD_HASH)
    (is-size-b32 PRESALE_TERMS_HASH)
    (is-uint64 INVENTORY_CAP)
    (is-uint64 SOLD_COUNT)
    (is-uint64 REDEEMED_COUNT)
    (is-uint64 REFUNDED_COUNT)
    (is-uint64 PHASE)
    (is-size-b32 my_id)
    (is-size-b32 my_inner_puzzle_hash)
    (is-uint64 my_amount)
    (is-uint64 transition_tag)
    (list
      (list ASSERT_MY_COIN_ID my_id)
      (list ASSERT_MY_AMOUNT my_amount)
      (list ASSERT_MY_PUZZLEHASH (calculate_full_puzzle_hash SINGLETON_STRUCT my_inner_puzzle_hash))
      (list REMARK PROTOCOL_PREFIX PRESALE_TERMS_HASH transition_tag transition_payload)
      (presale-transition)
    )
  )
)
