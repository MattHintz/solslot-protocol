;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; CAT tail program for Solslot pool share tokens.
;;;
;;; Pool tokens are UNGATED — free CATs that trade on any wallet/DEX.
;;; Minting and melting are authorized exclusively by the pool singleton
;;; via puzzle announcement.
;;;
;;; Curried parameters:
;;;   POOL_SINGLETON_MOD_HASH — singleton mod hash
;;;   POOL_LAUNCHER_ID — pool singleton launcher id
;;;   POOL_LAUNCHER_PUZZLE_HASH — launcher puzzle hash
;;;
;;; Direct/CAT V2 solution:
;;;   pool_full_puzzle_hash — current pool singleton full puzzle hash
;;;   pool_inner_puzzle_hash — current pool inner puzzle hash
;;;   pool_coin_id — pool singleton coin id (for anti-ephemeral)
;;;   my_coin_id — this token's coin id
;;;   mint_or_melt — 1 for mint, -1 for melt, 0 for transfer
;;;   amount — amount being minted or melted (ignored for transfer)
;;;
;;; CAT2 invocation solution:
;;;   Truths parent_is_cat lineage_proof delta inner_conditions tail_solution
;;;
;;; where tail_solution is the direct V2 Solslot payload above.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(mod
    (
        POOL_SINGLETON_MOD_HASH
        POOL_LAUNCHER_ID
        POOL_LAUNCHER_PUZZLE_HASH
        ;; --- solution ---
        arg0
        arg1
        arg2
        arg3
        arg4
        arg5
    )

    (include cat_truths.clib)
    (include condition_codes.clib)
    (include utils.clib)
    (include utility_macros.clib)

    (defun-inline expected_pool_full_puzzle_hash
        (POOL_SINGLETON_MOD_HASH POOL_LAUNCHER_ID POOL_LAUNCHER_PUZZLE_HASH pool_inner_puzzle_hash)
        (calculate_full_puzzle_hash
            (c POOL_SINGLETON_MOD_HASH (c POOL_LAUNCHER_ID POOL_LAUNCHER_PUZZLE_HASH))
            pool_inner_puzzle_hash)
    )

    (defun-inline token_authorization_message (mint_or_melt my_coin_id amount)
        (concat PROTOCOL_PREFIX (sha256tree (list mint_or_melt my_coin_id amount)))
    )

    (defun run-pool-token-tail
        (POOL_SINGLETON_MOD_HASH POOL_LAUNCHER_ID POOL_LAUNCHER_PUZZLE_HASH
         pool_full_puzzle_hash pool_inner_puzzle_hash pool_coin_id my_coin_id mint_or_melt amount)
        ;; Transfers (mint_or_melt = 0) are always allowed — ungated CAT.
        ;; Mints (1) and melts (-1) require both a pool singleton puzzle
        ;; announcement and a same-coin announcement from the pool coin.
        (if mint_or_melt
            (assert
                (is-size-b32 pool_full_puzzle_hash)
                (is-size-b32 pool_inner_puzzle_hash)
                (= pool_full_puzzle_hash
                    (expected_pool_full_puzzle_hash
                        POOL_SINGLETON_MOD_HASH
                        POOL_LAUNCHER_ID
                        POOL_LAUNCHER_PUZZLE_HASH
                        pool_inner_puzzle_hash))
                (is-size-b32 pool_coin_id)
                (is-size-b32 my_coin_id)
                (is-uint64 amount)
                (list
                    (list ASSERT_MY_COIN_ID my_coin_id)
                    (list ASSERT_PUZZLE_ANNOUNCEMENT
                        (sha256
                            pool_full_puzzle_hash
                            (token_authorization_message mint_or_melt my_coin_id amount)))
                    (list ASSERT_COIN_ANNOUNCEMENT
                        (sha256
                            pool_coin_id
                            (token_authorization_message mint_or_melt my_coin_id amount)))
                )
            )
            ;; Transfer: no conditions — always allowed
            ()
        )
    )

    ;; In live CAT2 spends, arg0 is Truths (a pair) and arg5 carries the
    ;; Solslot-specific tail_solution.
    (if (l arg0)
        (run-pool-token-tail
            POOL_SINGLETON_MOD_HASH
            POOL_LAUNCHER_ID
            POOL_LAUNCHER_PUZZLE_HASH
            (f arg5)
            (f (r arg5))
            (f (r (r arg5)))
            (my_id_cat_truth arg0)
            (f (r (r (r (r arg5)))))
            (f (r (r (r (r (r arg5))))))
        )
        (run-pool-token-tail
            POOL_SINGLETON_MOD_HASH
            POOL_LAUNCHER_ID
            POOL_LAUNCHER_PUZZLE_HASH
            arg0 arg1 arg2 arg3 arg4 arg5)
    )
)
