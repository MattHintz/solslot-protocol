;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; SGT free-state inner puzzle.
;;;
;;; This is the CAT2 inner puzzle attached to every SGT coin while it is
;;; freely transferable / available for governance participation.  Every
;;; non-locked SGT coin in existence has this exact mod with appropriate
;;; INNER_PUZZLE_HASH curried in.
;;;
;;; Two spend cases:
;;;   1 — PROTOCOL TRANSITION: run an immutable protocol inner puzzle and
;;;                  replace every
;;;                  CREATE_COIN with one whose puzhash is a re-curry of
;;;                  sgt_free_inner around the requested new owner hash.
;;;                  At least one output is required. CAT2 conservation
;;;                  remains authoritative for the total output amount.
;;;                  The inner must emit the exact SGT protocol-transition
;;;                  marker. Ordinary p2_vault spends cannot emit it, so SGT
;;;                  held by a vault cannot be migrated to an arbitrary owner.
;;;                  All other inner conditions pass through unchanged
;;;                  except that REMARK / SEND_MESSAGE / RECEIVE_MESSAGE
;;;                  using the solslot PROTOCOL_PREFIX are rejected so a
;;;                  malicious inner puzzle cannot spoof governance traffic.
;;;
;;;   2 — LOCK     : commit this SGT coin to a specific proposal hash for
;;;                  a fixed deadline.  The user's inner puzzle authorises
;;;                  the action by signing a delegated puzzle that emits
;;;                  exactly one CREATE_COIN whose target equals the
;;;                  sgt_locked_inner full puzzle hash for those params.
;;;
;;; Curried parameters (immutable per SGT lineage):
;;;   MOD_HASH                — self-reference (this mod's tree hash)
;;;   LOCKED_MOD_HASH         — sgt_locked_inner mod hash (re-curry target)
;;;   PROPOSAL_TRACKER_STRUCT — singleton struct of the tracker.
;;;   INNER_PUZZLE_HASH       — current owner's user puzzle hash.
;;;
;;; Solution shape:
;;;   spend_case        — 1 (TRANSFER) | 2 (LOCK)
;;;   inner_puzzle      — reveal of the user's puzzle (must hash to INNER_PUZZLE_HASH)
;;;   inner_solution    — the user's solution
;;;   case_args         — TRANSFER: ()
;;;                     — LOCK: (proposal_hash deadline my_amount)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(mod (
        MOD_HASH
        LOCKED_MOD_HASH
        PROPOSAL_TRACKER_STRUCT
        INNER_PUZZLE_HASH
        ;; --- solution ---
        spend_case
        inner_puzzle
        inner_solution
        case_args
     )

    (include condition_codes.clib)
    (include utils.clib)
    (include utility_macros.clib)

    ;; Spend case constants
    (defconstant SGT_TRANSFER 1)
    (defconstant SGT_LOCK 2)
    (defconstant SGT_PROTOCOL_TRANSITION_TAG 0x53475450) ; "SGTP"

    ;; LOCK announcement tag (4 ASCII bytes "LOCK")
    (defconstant LOCK_TAG 0x4c4f434b)

    ;; ----- Recursive condition filters -----
    ;; Each defun receives every mod-level arg it needs as an explicit
    ;; parameter — this dialect of Chialisp does not give regular defuns
    ;; access to the mod environment, so passing them through is mandatory.

    ;; Reject any condition that could spoof governance traffic.  Inner
    ;; puzzles authorize ownership transitions only — all protocol-level
    ;; messaging and announcements are emitted by the SGT wrapper itself.
    ;;
    ;;   - REMARK whose first arg is PROTOCOL_PREFIX  (governance REMARKs)
    ;;   - any SEND_MESSAGE or RECEIVE_MESSAGE        (wrapper-only)
    ;;   - any CREATE_PUZZLE_ANNOUNCEMENT             (wrapper-only)  *V1-CANON-001*
    ;;   - any CREATE_COIN_ANNOUNCEMENT               (wrapper-only)  *V1-CANON-001*
    ;;
    ;; V1-CANON-001 background: prior versions filtered only REMARK +
    ;; SEND/RECEIVE_MESSAGE.  An attacker could spend a SGT in TRANSFER
    ;; mode, emit one valid CREATE_COIN (so SGT remained free), AND
    ;; emit a forged CREATE_PUZZLE_ANNOUNCEMENT carrying the protocol
    ;; LOCK announcement — the proposal tracker would accept the
    ;; spoofed announcement as SGT vote weight, defeating CRITICAL-3's
    ;; SGT-CAT conservation invariant.  The fix bans inner-emitted
    ;; CREATE_*_ANNOUNCEMENT entirely; the wrapper retains exclusive
    ;; authority to emit the LOCK announcement (only in LOCK mode).
    ;;
    ;; PROTOCOL_PREFIX is a defconstant from utility_macros.clib (a literal).
    (defun-inline is-protocol-transition-marker (cond_code cond_body)
        (and
            (= cond_code REMARK)
            (= (f cond_body) PROTOCOL_PREFIX)
            (= (f (r cond_body)) SGT_PROTOCOL_TRANSITION_TAG)
            (not (r (r cond_body))))
    )

    (defun-inline check_no_protocol_prefix_abuse (cond_code cond_body)
        (if (= cond_code REMARK)
            (if (= (f cond_body) PROTOCOL_PREFIX)
                (is-protocol-transition-marker cond_code cond_body)
                1)
            (if (any (= cond_code SEND_MESSAGE) (= cond_code RECEIVE_MESSAGE))
                (x)
                (if (any (= cond_code CREATE_PUZZLE_ANNOUNCEMENT)
                         (= cond_code CREATE_COIN_ANNOUNCEMENT))
                    (x)
                    1)))
    )

    ;; Compute the puzzle hash of sgt_free_inner curried with a given owner.
    (defun-inline compute_self_free_puzhash
            (mod_hash locked_mod_hash tracker_struct new_inner_hash)
        (curry_hashes mod_hash
            (sha256 1 mod_hash)
            (sha256 1 locked_mod_hash)
            (sha256tree tracker_struct)
            (sha256 1 new_inner_hash))
    )

    ;; Compute the puzzle hash of sgt_locked_inner for given lock params.
    (defun-inline compute_locked_puzhash
            (mod_hash locked_mod_hash tracker_struct owner_inner_hash
             proposal_hash deadline)
        (curry_hashes locked_mod_hash
            (sha256 1 locked_mod_hash)
            (sha256 1 mod_hash)
            (sha256tree tracker_struct)
            (sha256 1 owner_inner_hash)
            (sha256 1 proposal_hash)
            (sha256 1 deadline))
    )

    ;; Walk the conditions list for TRANSFER mode: rewrap every CREATE_COIN
    ;; destination, anti-spoof everything else, and require at least one
    ;; output. Supporting multiple outputs is necessary for ordinary SGT coin
    ;; splitting and for governed reserve allocations. CAT2 still proves
    ;; conservation across the complete spend bundle.
    (defun filter_transfer
            (mod_hash locked_mod_hash tracker_struct
             conditions found_create_coin found_protocol_marker acc)
        (if conditions
            (if (= (f (f conditions)) CREATE_COIN)
                (assert
                    (is-size-b32 (f (r (f conditions))))
                    (is-uint64 (f (r (r (f conditions)))))
                    (filter_transfer mod_hash locked_mod_hash tracker_struct
                        (r conditions) 1 found_protocol_marker
                        (c
                            (list CREATE_COIN
                                (compute_self_free_puzhash
                                    mod_hash locked_mod_hash tracker_struct
                                    (f (r (f conditions))))
                                (f (r (r (f conditions))))
                                (list (f (r (f conditions)))))
                            acc)))
                (assert
                    (check_no_protocol_prefix_abuse
                        (f (f conditions)) (r (f conditions)))
                    (filter_transfer mod_hash locked_mod_hash tracker_struct
                        (r conditions) found_create_coin
                        (or found_protocol_marker
                            (is-protocol-transition-marker
                                (f (f conditions)) (r (f conditions))))
                        (c (f conditions) acc))))
            (assert found_create_coin found_protocol_marker acc))
    )

    ;; Walk the conditions list for LOCK mode: verify the single CREATE_COIN
    ;; goes to the expected sgt_locked_inner puzhash, and pass through other
    ;; conditions (with the same anti-spoof check).
    (defun filter_lock
            (conditions expected_locked_puzhash my_amount
             found_create_coin acc)
        (if conditions
            (if (= (f (f conditions)) CREATE_COIN)
                (assert
                    (not found_create_coin)
                    (= (f (r (f conditions))) expected_locked_puzhash)
                    (= (f (r (r (f conditions)))) my_amount)
                    (filter_lock (r conditions) expected_locked_puzhash my_amount
                        1 (c (f conditions) acc)))
                (assert
                    (if (= (f (f conditions)) CREATE_COIN_ANNOUNCEMENT)
                        1
                        (check_no_protocol_prefix_abuse
                            (f (f conditions)) (r (f conditions))))
                    (filter_lock (r conditions) expected_locked_puzhash my_amount
                        found_create_coin (c (f conditions) acc))))
            (assert found_create_coin acc))
    )

    ;; ----- Top-level dispatcher (mod-level args available here) -----
    (assert
        (is-size-b32 INNER_PUZZLE_HASH)
        (if (= spend_case SGT_TRANSFER)
            (assert
                (= (sha256tree inner_puzzle) INNER_PUZZLE_HASH)
                (filter_transfer
                    MOD_HASH LOCKED_MOD_HASH PROPOSAL_TRACKER_STRUCT
                    (a inner_puzzle inner_solution) 0 0 ()))
            (if (= spend_case SGT_LOCK)
                (assert
                    (is-size-b32 (f case_args))           ; proposal_hash
                    (is-uint64 (f (r case_args)))         ; deadline
                    (is-uint64 (f (r (r case_args))))     ; my_amount
                    (= (sha256tree inner_puzzle) INNER_PUZZLE_HASH)
                    (c
                        ;; Lock announcement for the proposal tracker.
                        (list CREATE_PUZZLE_ANNOUNCEMENT
                            (concat PROTOCOL_PREFIX
                                (sha256tree
                                    (list LOCK_TAG
                                        (f case_args)             ; proposal_hash
                                        (f (r (r case_args)))     ; my_amount
                                        (f (r case_args))))))     ; deadline
                        (c
                            ;; Lock window: must be spent before the deadline.
                            (list ASSERT_BEFORE_SECONDS_ABSOLUTE (f (r case_args)))
                            (filter_lock
                                (a inner_puzzle inner_solution)
                                (compute_locked_puzhash
                                    MOD_HASH LOCKED_MOD_HASH PROPOSAL_TRACKER_STRUCT
                                    INNER_PUZZLE_HASH
                                    (f case_args) (f (r case_args)))
                                (f (r (r case_args)))
                                0 ()))))
                (x))))
)
