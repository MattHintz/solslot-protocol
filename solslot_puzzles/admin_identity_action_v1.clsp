;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Canonical paired action for an Authority V3 identity singleton.
;;;
;;; Every state-changing field is curried into the delegated-puzzle hash.
;;; The only solution value is the current coin id, which is checked with
;;; ASSERT_MY_COIN_ID. This avoids a self-referential puzzle hash while still
;;; binding the spend to the exact live identity coin.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(mod
  (
    ACTION_TAG
    OUTPUT_CUSTODY_HASH
    AUTHORITY_FULL_PUZZLE_HASH
    AUTHORITY_DELEGATED_PUZZLE_HASH
    AUTHORITY_ANNOUNCEMENT_MESSAGE
    COIN_ANNOUNCEMENT_MESSAGE
    MY_FULL_PUZZLE_HASH
    MY_AMOUNT
    my_coin_id
  )

  (include condition_codes.clib)
  (include utils.clib)
  (include utility_macros.clib)

  (defconstant SINGLETON_MEMBER_MODE 0x12)

  (defun-inline maybe-assert-authority (message)
    (if message
      (list
        (list ASSERT_PUZZLE_ANNOUNCEMENT
          (sha256 AUTHORITY_FULL_PUZZLE_HASH message)))
      ()))

  (defun-inline maybe-create-coin-announcement (message)
    (if message
      (list (list CREATE_COIN_ANNOUNCEMENT message))
      ()))

  (assert
    (> ACTION_TAG 0)
    (is-size-b32 OUTPUT_CUSTODY_HASH)
    (is-size-b32 AUTHORITY_FULL_PUZZLE_HASH)
    (is-size-b32 AUTHORITY_DELEGATED_PUZZLE_HASH)
    (is-size-b32-or-nil AUTHORITY_ANNOUNCEMENT_MESSAGE)
    (is-size-b32-or-nil COIN_ANNOUNCEMENT_MESSAGE)
    (is-size-b32 MY_FULL_PUZZLE_HASH)
    (is-size-b32 my_coin_id)
    (is-uint64 MY_AMOUNT)
    (> MY_AMOUNT 0)
    (logand MY_AMOUNT 1)
    (c
      (list CREATE_COIN OUTPUT_CUSTODY_HASH MY_AMOUNT)
      (merge-lists
        (maybe-assert-authority AUTHORITY_ANNOUNCEMENT_MESSAGE)
        (merge-lists
          (maybe-create-coin-announcement COIN_ANNOUNCEMENT_MESSAGE)
          (list
            (list SEND_MESSAGE
              SINGLETON_MEMBER_MODE
              AUTHORITY_DELEGATED_PUZZLE_HASH
              AUTHORITY_FULL_PUZZLE_HASH)
            (list ASSERT_MY_COIN_ID my_coin_id)
            (list ASSERT_MY_PUZZLEHASH MY_FULL_PUZZLE_HASH)
            (list ASSERT_MY_AMOUNT MY_AMOUNT))))))
)
