; Primary principal goes to the committed offering proceeds, never the fee bucket.
(
  ; Immutable batch bindings: generation, pool structure/kernel, real SGT
  ; holdings bindings, statutes structure, protocol treasury, payment modules.
  ; This branch has no unverified human destination. The newly delivered deed
  ; MUST co-spend into the real pool before any payment can complete.
  (defun pa-nth (n xs) (if n (pa-nth (- n 1) (r xs)) (f xs)))
  (defun pa-length (xs) (if xs (+ 1 (pa-length (r xs))) 0))
  (defun pa-hashes (xs) (if xs (c (sha256tree (f xs)) (pa-hashes (r xs))) ()))
  (defun pa-append (a b) (if a (c (f a) (pa-append (r a) b)) b))
  (defun-inline pa-curry (mod xs)
    (tree_hash_of_apply mod (calculate_hash_of_curried_parameters (pa-hashes xs))))
  (defun-inline pa-fee-inner (b t source route asset total)
    (pa-curry (pa-nth 0 (pa-nth 6 b))
      (list (pa-nth 0 (pa-nth 6 b)) (pa-nth 3 b) (pa-nth 4 b) asset
        (pa-nth 10 t) (pa-nth 1 (pa-nth 6 b)) (pa-nth 2 (pa-nth 6 b))
        (pa-nth 3 (pa-nth 6 b)) (pa-nth 4 (pa-nth 6 b)) (pa-nth 5 (pa-nth 6 b)) (pa-nth 6 (pa-nth 6 b))
        source route (pa-nth 5 t) (pa-nth 7 t) (pa-nth 8 t) total (pa-nth 13 t) (pa-nth 5 b))))
  (defun-inline pa-rewards (b t asset)
    (pa-curry (pa-nth 1 (pa-nth 6 b))
      (list (pa-nth 1 (pa-nth 6 b)) (pa-nth 3 b) (pa-nth 4 b) asset (pa-nth 10 t)
        (pa-nth 2 (pa-nth 6 b)) (pa-nth 3 (pa-nth 6 b)) (pa-nth 4 (pa-nth 6 b))
        (pa-nth 5 (pa-nth 6 b)) (pa-nth 6 (pa-nth 6 b)))))
  (defun-inline pa-full-fee (b t source route asset total)
    (if (= asset ZERO_B32) (pa-fee-inner b t source route asset total)
      (curry_hashes (pa-nth 10 t) (sha256 1 (pa-nth 10 t)) (sha256 1 asset) (pa-fee-inner b t source route asset total))))
  (defun-inline pa-route (b t args)
    (sha256tree (list "PRIMARY_SOLS_V1" (f b) (pa-nth 0 args) (pa-nth 3 args)
      (pa-nth 13 args) (pa-nth 6 args) (pa-nth 7 args) (pa-nth 8 args)
      (pa-nth 9 args) (pa-nth 10 args) (pa-nth 11 args) (pa-nth 12 args)
      (f t) (pa-nth 17 args))))
  (defun-inline pa-fee-identity (b t args route)
    (list (f b) route (pa-nth 14 args) (pa-nth 6 args) (pa-nth 7 args)))
  (defun pa-primary-conditions (b t args route fee_ph rewards_ph principal protocol rewards)
    (merge-lists
      (list
        (list ASSERT_MY_COIN_ID (pa-nth 0 args))
        (list ASSERT_MY_PARENT_ID (pa-nth 1 args))
        (list ASSERT_MY_PUZZLEHASH (pa-nth 2 args))
        (list ASSERT_MY_AMOUNT 1)
        (list ASSERT_SECONDS_ABSOLUTE (pa-nth 9 (pa-nth 19 args)))
        (list ASSERT_BEFORE_SECONDS_ABSOLUTE (pa-nth 12 args))
        (list CREATE_COIN (f t) 1)
        (list SEND_MESSAGE 18
          (sha256tree (list "PRIMARY_SOLS_POOL" (f b) route (pa-nth 17 args) (pa-nth 13 args)))
          (calculate_full_puzzle_hash (pa-nth 1 b) (pa-nth 4 args)))
        (list RECEIVE_MESSAGE 18
          (sha256tree (list "PRIMARY_SOLS_ACCEPTED" (f b) route (pa-nth 17 args) (pa-nth 13 args)))
          (calculate_full_puzzle_hash (pa-nth 1 b) (pa-nth 4 args)))
        (list SEND_MESSAGE 18 (sha256tree (list "PRIMARY_QUOTE_REQUEST" (f b) route))
          (calculate_full_puzzle_hash (pa-nth 4 b) (pa-nth 15 args)))
        (list RECEIVE_MESSAGE 18
          (sha256tree (list "PRIMARY_QUOTE" (f b) route (pa-nth 6 args) (pa-nth 8 args)
            (pa-nth 9 args) (pa-nth 10 args) (pa-nth 11 args) (pa-nth 12 args)))
          (calculate_full_puzzle_hash (pa-nth 4 b) (pa-nth 15 args)))
        (list SEND_MESSAGE 18
          (sha256tree (c "PRIMARY_FEE_ROUTE_V1" (pa-append (pa-fee-identity b t args route)
            (list (pa-nth 5 t) (pa-nth 7 t) (pa-nth 8 t) (sha256tree (pa-nth 16 args))
              (pa-nth 13 t) (pa-nth 5 b) rewards_ph)))) fee_ph)
        (list RECEIVE_MESSAGE 18
          (sha256tree (c "PRIMARY_FEE_PAID_V1" (pa-append (pa-fee-identity b t args route)
            (list principal protocol rewards (sha256tree (pa-nth 16 args))
              (pa-nth 13 t) (pa-nth 5 b) rewards_ph)))) fee_ph)
        (list REMARK "SOLSLOT_PRIMARY_SOLS" (f b) route (pa-nth 13 args)))
      (merge-lists (emit-sigs (pa-nth 12 t) (pa-nth 18 args)
        (sha256tree (list "PRIMARY_SOLS_DELIVERY" (f b) route (sha256tree args))))
        (pa-oracle-signatures (pa-nth 7 b) (pa-nth 20 args)
          (sha256tree (list "SOLSLOT_ORACLE_ROUND_AUTH_V1" (pa-nth 9 args)))))))
  ; Reuse the existing read-only two-source H-system attestation verbatim.
  ; This domain authorizes a price fact, never an asset spend or administrator
  ; action. The delivery signatures separately bind the exact generation/NFT.
  (defun pa-oracle-signatures (keys indices message)
    (if indices (c (list AGG_SIG_UNSAFE (pa-nth (f indices) keys) message)
      (pa-oracle-signatures keys (r indices) message)) ()))
  (defun primary-acquire (b own t args)
    (assert (= (pa-length b) 8) (= (pa-length args) 21)
      (= (pa-length (pa-nth 6 b)) 7) (= (pa-length (pa-nth 3 b)) 6)
      (= (f b) (f (pa-nth 3 b)))
      (= (pa-length (pa-nth 7 b)) 3) (all-bls-g1-pubkeys (pa-nth 7 b))
      (has-no-duplicates (pa-nth 7 b) ())
      (= (pa-length (pa-nth 19 args)) 12)
      (= (pa-nth 0 (pa-nth 19 args)) 1) (= (pa-nth 1 (pa-nth 19 args)) "testnet11")
      (= (pa-nth 3 (pa-nth 19 args)) (pa-nth 6 args))
      (= (pa-nth 4 (pa-nth 19 args)) (pa-nth 8 args))
      (= (pa-nth 5 (pa-nth 19 args)) (sha256tree (pa-nth 7 b)))
      (= (pa-nth 6 (pa-nth 19 args)) 2)
      (not (> 2 (pa-length (pa-nth 7 (pa-nth 19 args)))))
      (not (> (pa-length (pa-nth 7 (pa-nth 19 args))) 8))
      (has-no-duplicates (pa-nth 7 (pa-nth 19 args)) ())
      (= (pa-nth 9 args) (sha256tree (pa-nth 19 args)))
      (= (pa-nth 10 args) (pa-nth 8 (pa-nth 19 args)))
      (= (pa-nth 11 args) (pa-nth 11 (pa-nth 19 args)))
      (> (pa-nth 9 (pa-nth 19 args)) 0)
      (> (pa-nth 10 (pa-nth 19 args)) (pa-nth 9 (pa-nth 19 args)))
      (not (> (- (pa-nth 10 (pa-nth 19 args)) (pa-nth 9 (pa-nth 19 args))) (pa-nth 1 (pa-nth 16 args))))
      (not (> (pa-nth 12 args) (pa-nth 10 (pa-nth 19 args))))
      (= (pa-length (pa-nth 20 args)) 2) (is-sorted-strict (pa-nth 20 args))
      (all-indices-in-range (pa-nth 20 args) 3)
      (= (sha256tree (pa-nth 5 args)) (f t))
      (= (pa-nth 2 args)
        (calculate_full_puzzle_hash (c (pa-nth 1 t) (c (pa-nth 2 t) (pa-nth 3 t))) own))
      (= (pa-nth 0 args) (sha256 (pa-nth 1 args) (pa-nth 2 args) 1))
      (= (pa-nth 6 t) 100) (= (pa-nth 7 t) (/ (+ (* (pa-nth 5 t) 100) 9999) 10000))
      (= (pa-nth 8 t) (+ (pa-nth 5 t) (pa-nth 7 t)))
      (is-size-b32 (pa-nth 6 args)) (is-size-b32 (pa-nth 13 args))
      (is-size-b32 (pa-nth 14 args)) (is-size-b32 (pa-nth 17 args))
      (rail-is-valid (pa-nth 8 t) (if (= (pa-nth 6 args) ZERO_B32) 3 4) 0
        (pa-nth 6 args) (pa-nth 8 args) (pa-nth 7 args) (pa-nth 9 args) (pa-nth 10 args) (pa-nth 11 args))
      (= (pa-length (pa-nth 16 args)) 6) (> (pa-nth 2 (pa-nth 16 args)) 0)
      (= (pa-length (pa-nth 18 args)) 2) (is-sorted-strict (pa-nth 18 args))
      (all-indices-in-range (pa-nth 18 args) 3)
      (pa-primary-conditions b t args (pa-route b t args)
        (pa-full-fee b t (pa-nth 2 args) (pa-route b t args) (pa-nth 6 args) (pa-nth 7 args))
        (pa-rewards b t (pa-nth 6 args))
        (- (pa-nth 7 args) (/ (+ (* (pa-nth 7 args) (pa-nth 7 t)) (- (pa-nth 8 t) 1)) (pa-nth 8 t)))
        (/ (+ (* (/ (+ (* (pa-nth 7 args) (pa-nth 7 t)) (- (pa-nth 8 t) 1)) (pa-nth 8 t))
          (pa-nth 3 (pa-nth 16 args))) (- (pa-nth 2 (pa-nth 16 args)) 1)) (pa-nth 2 (pa-nth 16 args)))
        (- (/ (+ (* (pa-nth 7 args) (pa-nth 7 t)) (- (pa-nth 8 t) 1)) (pa-nth 8 t))
          (/ (+ (* (/ (+ (* (pa-nth 7 args) (pa-nth 7 t)) (- (pa-nth 8 t) 1)) (pa-nth 8 t))
            (pa-nth 3 (pa-nth 16 args))) (- (pa-nth 2 (pa-nth 16 args)) 1)) (pa-nth 2 (pa-nth 16 args)))))))
)
