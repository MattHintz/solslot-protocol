(mod
  (
    PRESALE_TERMS_HASH
    SERIAL
    PAYMENT_RECORD_HASH
    ORIGINAL_VAULT_LAUNCHER_ID
    ORIGINAL_VAULT_PUZZLE_HASH
    BASE_DEPOSITOR_COMMITMENT
    PAYMENT_PRINCIPAL
    PAYMENT_RAIL
    SERIES_SINGLETON_ID
    phase
    action
    child_deed_puzzle_hash
  )
  (include condition_codes.clib)
  (include utils.clib)
  (include utility_macros.clib)
  (defconstant PHASE_PRESALE 1)
  (defconstant PHASE_LIVE 2)
  (defconstant ACTION_REFUND 1)
  (defconstant ACTION_REDEEM 2)
  (assert
    (if (= action ACTION_REFUND)
      (assert
        (= phase PHASE_PRESALE)
        (list
          (list REMARK "SOLSLOT_VOUCHER_REFUND_V1" PRESALE_TERMS_HASH SERIAL PAYMENT_RECORD_HASH ORIGINAL_VAULT_LAUNCHER_ID BASE_DEPOSITOR_COMMITMENT PAYMENT_PRINCIPAL PAYMENT_RAIL SERIES_SINGLETON_ID)))
      (assert
        (= action ACTION_REDEEM)
        (= phase PHASE_LIVE)
        (list
          (list CREATE_COIN child_deed_puzzle_hash 1)
          (list REMARK "SOLSLOT_VOUCHER_REDEEM_V1" PRESALE_TERMS_HASH SERIAL PAYMENT_RECORD_HASH ORIGINAL_VAULT_LAUNCHER_ID ORIGINAL_VAULT_PUZZLE_HASH SERIES_SINGLETON_ID))))
  )
)
