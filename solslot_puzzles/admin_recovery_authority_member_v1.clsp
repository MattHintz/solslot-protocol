;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Authority V3 recovery member.
;;;
;;; A recovery BLS approval is valid only when a coin locked to the current
;;; Authority singleton puzzle is spent in the same bundle. The singleton
;;; launcher is curried; the current inner puzzle hash is supplied by the
;;; recovery solution. The member also requires that exact Authority spend to
;;; announce a lost-key prepare state transition. This prevents a recovery
;;; spend from hitchhiking on an unrelated operational, completion, or cancel
;;; spend. A fabricated coin cannot satisfy either assertion because the
;;; singleton top layer enforces launcher lineage.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(mod
  (
    RECOVERY_PUBLIC_KEY
    AUTHORITY_SINGLETON_STRUCT
    Delegated_Puzzle
    authority_inner_puzzle_hash
    pending_authority_state_hash
  )

  (include condition_codes.clib)
  (include utils.clib)
  (include utility_macros.clib)

  (defconstant SPEND_PREPARE_LOST 0x03)

  (defun-inline authority-full-puzzle-hash (inner_puzzle_hash)
    (calculate_full_puzzle_hash
      AUTHORITY_SINGLETON_STRUCT
      inner_puzzle_hash))

  (assert
    (is-size-b32 authority_inner_puzzle_hash)
    (is-size-b32 pending_authority_state_hash)
    (list
      (list AGG_SIG_ME RECOVERY_PUBLIC_KEY Delegated_Puzzle)
      (list ASSERT_CONCURRENT_PUZZLE
        (authority-full-puzzle-hash authority_inner_puzzle_hash))
      (list ASSERT_PUZZLE_ANNOUNCEMENT
        (sha256
          (authority-full-puzzle-hash authority_inner_puzzle_hash)
          (concat
            PROTOCOL_PREFIX
            SPEND_PREPARE_LOST
            pending_authority_state_hash)))))
)
