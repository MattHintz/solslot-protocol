; Preserve the original funded leaf while requiring its exact co-spend.
(
(defconstant GV_REDEMPTION_LEAF 0x78a759362ae12e73aee1986043fb6e8e0df21ed6e104ed0dc0bd2831c10816dc)
(defconstant GV_CAT_MOD 0x37bef360ee858133b69d595a906dc45d01af50379dad515eb9518abb7c1d2a7a)
(defun gv-cat (asset inner)
  (curry_hashes GV_CAT_MOD (sha256 1 GV_CAT_MOD) (sha256 1 asset) inner))
(defun gv-deed-ph (structure deed proof)
  (calculate_full_puzzle_hash (c (f structure) (c (gv-nth 0 deed) (gv-nth 2 proof))) (gv-p2 structure)))
(defun gv-leaf-ph (structure deed payment proof)
  (gv-cat (gv-nth 0 payment)
    (curry_hashes GV_REDEMPTION_LEAF
      (sha256 1 GV_REDEMPTION_LEAF) (sha256 1 GV_CAT_MOD) (sha256 1 (gv-nth 0 payment))
      (sha256 1 OFFER_MOD_HASH) (sha256 1 (f structure)) (sha256 1 (gv-nth 2 proof))
      (sha256 1 (gv-nth 2 deed)) (sha256 1 (gv-nth 3 deed)) (sha256 1 (gv-nth 0 deed))
      (sha256 1 (gv-nth 1 deed)) (sha256tree (gv-nth 4 proof)) (sha256tree (gv-nth 1 payment)))))
(defun gv-redeem (deed payment signature proof structure pubkey auth identity policy mid inner amount)
  (assert (= (list-length deed) 4) (= (list-length payment) 5) (= (list-length proof) 5)
    (is-size-b32 (gv-nth 0 deed)) (is-size-b32 (gv-nth 1 deed))
    (is-size-b32 (gv-nth 2 deed)) (is-size-b32 (gv-nth 3 deed))
    (is-size-b32 (gv-nth 0 payment)) (not (= (gv-nth 0 payment) ZERO_B32))
    (is-uint64 (gv-nth 1 payment)) (> (gv-nth 1 payment) 0)
    (is-size-b32 (gv-nth 2 payment)) (is-size-b32 (gv-nth 3 payment)) (is-size-b32 (gv-nth 4 payment))
    (is-size-b32 (gv-nth 0 proof)) (is-size-b32 (gv-nth 1 proof))
    (is-size-b32 (gv-nth 2 proof)) (is-size-b32 (gv-nth 3 proof))
    (is-uint64 (gv-nth 4 proof)) (> (gv-nth 4 proof) 0) (not (> (gv-nth 4 proof) 1000000))
    (not (= identity ZKPASSPORT_EMPTY_ATTEST_ROOT)) (not (= identity ZERO_B32)) (not (= policy ZERO_B32))
    (= (gv-nth 0 proof) (sha256 (gv-nth 1 proof) (gv-deed-ph structure deed proof) 1))
    (= (gv-nth 3 payment) (sha256tree (list (list (gv-nth 1 proof) (gv-deed-ph structure deed proof) 1))))
    (= (gv-nth 4 payment) (sha256 (gv-cat (gv-nth 0 payment) OFFER_MOD_HASH)
      (sha256tree (c (gv-nth 3 payment)
        (list (list (gv-nth 2 payment) (gv-nth 1 payment)
          (list (gv-nth 2 deed) (gv-nth 3 deed) (gv-nth 0 deed) (gv-nth 1 deed))))))))
    (merge-lists (base_conditions structure mid amount inner)
      (list
        (authenticate_operation auth pubkey 'd' (sha256tree (list "RDA2" mid deed payment proof)) mid signature)
        (list ASSERT_CONCURRENT_SPEND (sha256 (gv-nth 3 proof) (gv-leaf-ph structure deed payment proof) (gv-nth 1 payment)))
        (list ASSERT_PUZZLE_ANNOUNCEMENT (gv-nth 4 payment))
        (list CREATE_PUZZLE_ANNOUNCEMENT (concat PROTOCOL_PREFIX
          (sha256tree (list VAULT_SWAP_TRANSFER_TAG mid (gv-nth 0 proof) (gv-nth 0 deed) OFFER_MOD_HASH))))
        (list ASSERT_COIN_ANNOUNCEMENT (sha256 (gv-nth 0 proof) (concat PROTOCOL_PREFIX
          (sha256tree (list VAULT_SWAP_TRANSFER_TAG mid (gv-nth 0 proof) (gv-nth 0 deed) OFFER_MOD_HASH)))))
        (list CREATE_COIN inner amount (list inner))))))
)
