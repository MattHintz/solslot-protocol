      "gov_member_hash",
      "voting_deadline"
    ],
    "protocol_context": [
      {
        "portal_key": "protocolDidSingletonStructHex",
        "api_setting": "protocol_did_singleton_struct_hex",
        "api_env": "SOLSLOT_PROTOCOL_DID_SINGLETON_STRUCT_HEX",
        "kind": "serialized_clvm_program"
      },
      {
        "portal_key": "protocolDidPuzhash",
        "api_setting": "protocol_did_puzhash",
        "api_env": "SOLSLOT_PROTOCOL_DID_PUZHASH",
        "kind": "bytes32"
      },
      {
        "portal_key": "poolLauncherId",
        "api_setting": "pool_launcher_id",
        "api_env": "SOLSLOT_POOL_LAUNCHER_ID",
        "kind": "bytes32"
      },
      {
        "portal_key": "p2PoolModHash",
        "api_setting": "p2_pool_mod_hash",
        "api_env": "SOLSLOT_P2_POOL_MOD_HASH",
        "kind": "bytes32"
